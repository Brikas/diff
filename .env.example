# Copy to .env next to docker-compose.yml.
# Host address and port the app is published on: the `web` bridge gateway, which Traefik reaches.
PUBLISH_IP=172.19.0.1
PUBLISH_PORT=9710
# Limits. New diffs plus new versions per client IP per rolling 24 h, and for everyone together.
MINTS_PER_IP_PER_DAY=100
MINTS_PER_DAY=2000
SAVES_PER_IP_PER_MINUTE=120
READS_PER_IP_PER_MINUTE=600
# Size of one diff: Before and After together, in kilobytes of UTF-8 text.
MAX_DIFF_KB=1024
MAX_DB_BYTES=2147483648
# Open connections at once; each can hold a request body of about 2 MB in memory.
MAX_CONNECTIONS=64
